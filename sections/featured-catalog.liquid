<section
  class="catalog"
  id="catalog-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="featured-catalog"
>
  <div class="catalog__container">
    <h2 class="catalog__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.subtext != blank %}
      <p class="catalog__subtext">{{ section.settings.subtext }}</p>
    {%- endif %}

    <div class="catalog__grid">
      {%- for block in section.blocks %}
        <div class="catalog__card" {{ block.shopify_attributes }}>
          <div class="catalog__card-image">
            {%- if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag:
                  class: 'catalog__img',
                  loading: 'lazy',
                  widths: '400,600,800',
                  sizes: '(min-width:900px) 25vw, 50vw'
              }}
            {%- else -%}
              <div class="catalog__img-placeholder" style="background:{{ block.settings.band_color }}"></div>
            {%- endif %}
          </div>
          <div class="catalog__card-info">
            <span class="catalog__card-origin">{{ block.settings.origin }}</span>
            <h3 class="catalog__card-name">{{ block.settings.name }}</h3>
            <p class="catalog__card-notes">{{ block.settings.notes }}</p>
          </div>
        </div>
      {%- endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Catalog",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our origins" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Four single-origin coffees, each with its own story." }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Product image" },
        { "type": "text", "id": "name", "label": "Name", "default": "Ethiopia Yirgacheffe" },
        { "type": "text", "id": "origin", "label": "Origin", "default": "Ethiopia" },
        { "type": "text", "id": "notes", "label": "Tasting notes", "default": "Jasmine, bergamot, raspberry" },
        { "type": "color", "id": "band_color", "label": "Band color", "default": "#B22234" }
      ]
    }
  ],
  "presets": [{
    "name": "Featured Catalog",
    "blocks": [
      { "type": "product_card", "settings": { "name": "Ethiopia Yirgacheffe", "origin": "Ethiopia", "notes": "Jasmine, bergamot, raspberry", "band_color": "#B22234" }},
      { "type": "product_card", "settings": { "name": "Colombia Huila", "origin": "Colombia", "notes": "Green apple, cane sugar, caramel", "band_color": "#4A7C59" }},
      { "type": "product_card", "settings": { "name": "Kenya Nyeri AA", "origin": "Kenya", "notes": "Blackcurrant, grapefruit, phosphoric acidity", "band_color": "#2D3A6A" }},
      { "type": "product_card", "settings": { "name": "Guatemala Antigua", "origin": "Guatemala", "notes": "Milk chocolate, hazelnut, vanilla", "band_color": "#C38A2F" }}
    ]
  }]
}
{% endschema %}