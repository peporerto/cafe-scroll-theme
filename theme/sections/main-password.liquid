{{ 'scene.css' | asset_url | stylesheet_tag }}
{{ 'pages.css' | asset_url | stylesheet_tag }}
<section class="pg pw scene scene--band pg--tall" data-depth-scene>
  {%- render 'scene-band', image: section.settings.scene_image, leaves: section.settings.show_leaves %}
  <div class="pg__inner pw__inner">
    <header class="pw__head layer">
      <p class="pg__eyebrow">{{ 'password.eyebrow' | t }}</p>
      <h1 class="pg__title">{{ shop.name }}</h1>
      {%- if shop.password_message != blank %}
        <div class="pg__intro rte">{{ shop.password_message }}</div>
      {%- endif %}
    </header>

    <div class="pw__panels">
      {%- if section.settings.show_email %}
        {%- form 'customer', class: 'pw__form panel' %}
          <h2 class="pw__h">{{ 'password.email_title' | t }}</h2>
          <input type="hidden" name="contact[tags]" value="prospect, password page">
          {%- if form.posted_successfully? %}
            <p class="contact__ok" role="status">{{ 'password.email_success' | t }}</p>
          {%- endif %}
          <div class="field">
            <label for="Pw-email">{{ 'password.email_label' | t }}</label>
            <input id="Pw-email" type="email" name="contact[email]" autocomplete="email" required>
          </div>
          <button type="submit" class="btn btn--primary">{{ 'password.email_submit' | t }}</button>
        {%- endform %}
      {%- endif %}

      {%- form 'storefront_password', class: 'pw__form panel' %}
        <h2 class="pw__h">{{ 'password.enter_title' | t }}</h2>
        {%- if form.errors %}
          <p class="contact__errors" role="alert">{{ 'password.wrong' | t }}</p>
        {%- endif %}
        <div class="field">
          <label for="Pw-password">{{ 'password.password_label' | t }}</label>
          <input id="Pw-password" type="password" name="password" autocomplete="current-password" required>
        </div>
        <button type="submit" class="btn btn--ghost">{{ 'password.enter' | t }}</button>
      {%- endform %}
    </div>
    <p class="pw__owner">{{ 'password.owner' | t }} <a href="{{ shop.url | append: '/admin' }}">{{ 'password.owner_link' | t }}</a></p>
  </div>
</section>

<script src="{{ 'pages.js' | asset_url }}" type="module" defer></script>

{% schema %}
{
  "name": "Password page",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "show_email", "label": "Show the email sign-up", "default": true },
    { "type": "header", "content": "Scene" },
    { "type": "image_picker", "id": "scene_image", "label": "Background photo", "info": "Overrides the default scene photo from Theme settings. Empty = use the default." },
    { "type": "checkbox", "id": "show_leaves", "label": "Show the branches in front of the scene", "default": true }
  ]
}
{% endschema %}
