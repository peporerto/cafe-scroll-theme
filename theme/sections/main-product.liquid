{{ 'scene.css' | asset_url | stylesheet_tag }}
{{ 'product.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign current = product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: section.id
  assign has_picker = false
  for b in section.blocks
    if b.type == 'variant_picker'
      assign has_picker = true
    endif
  endfor
  assign crumb_collection = collection
  if crumb_collection == blank
    assign crumb_collection = product.collections.first
  endif

  comment
    Three zones: the headline (title + tasting notes), the buy panel (everything you decide with) and the rest below the scene.
    The order of blocks in the theme editor decides the order inside each zone.
  endcomment
  assign zone_head = 'title,tasting_notes' | split: ','
  assign zone_panel = 'price,variant_picker,selling_plan,buy_buttons,trust_row,@app' | split: ','
  assign zone_below = 'roast_scale,description,accordion' | split: ','

  assign card_media = product.featured_media
  if current.featured_media != blank
    for m in product.media
      if m.id == current.featured_media.id
        assign card_media = m
      endif
    endfor
  endif
-%}

<section
  class="pdp{% if section.settings.image_fit == 'contain' %} pdp--contain{% endif %}"
  id="pdp-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="main-product"
  data-form-id="{{ form_id }}"
>
  <div class="pdp__scene scene" data-depth-scene>
    {%- if section.settings.scene_image != blank %}
      {{
        section.settings.scene_image
        | image_url: width: 2400
        | image_tag:
          class: 'scene__bg layer',
          loading: 'eager',
          fetchpriority: 'high',
          widths: '1200,1800,2400',
          sizes: '100vw',
          alt: ''
      }}
    {%- else %}
      <div class="scene__bg scene__bg--empty layer" aria-hidden="true"></div>
    {%- endif %}
    <div class="scene__fog layer" aria-hidden="true"></div>
    <div class="scene__fade" aria-hidden="true"></div>

    <nav class="pdp__crumbs scene__content" aria-label="{{ 'general.breadcrumb' | t }}">
      <ol>
        <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
        {%- if crumb_collection != blank %}
          <li><a href="{{ crumb_collection.url }}">{{ crumb_collection.title }}</a></li>
        {%- endif %}
        <li><span aria-current="page">{{ product.title }}</span></li>
      </ol>
    </nav>

    {%- comment -%} The photo of the selected variant, floating over the scene. JS swaps it when the variant changes. {%- endcomment -%}
    {%- if card_media != blank %}
      <figure class="pdp__card layer" data-hero-card data-media-id="{{ card_media.id }}">
        {{
          card_media.preview_image
          | image_url: width: 900
          | image_tag:
            class: 'pdp__card-img',
            loading: 'eager',
            fetchpriority: 'high',
            widths: '360,540,720,900',
            sizes: '(min-width: 900px) 21vw, 62vw',
            alt: card_media.alt
        }}
      </figure>
    {%- endif %}

    <div class="pdp__headline layer scene__content">
      {%- for block in section.blocks %}
        {%- if zone_head contains block.type %}
          {%- render 'pdp-block', block: block, section_id: section.id, form_id: form_id, has_picker: has_picker, current: current, product: product %}
        {%- endif %}
      {%- endfor %}
    </div>

    <div class="pdp__panel layer scene__content">
      {%- for block in section.blocks %}
        {%- if zone_panel contains block.type %}
          {%- render 'pdp-block', block: block, section_id: section.id, form_id: form_id, has_picker: has_picker, current: current, product: product %}
        {%- endif %}
      {%- endfor %}
    </div>

    {%- if section.settings.show_leaves %}
      {%- render 'scene-leaves' %}
    {%- endif %}
  </div>

  <div class="pdp__below{% if product.media.size < 2 %} pdp__below--solo{% endif %}">
    {%- if product.media.size > 1 %}
      <ul class="pdp__gallery" role="list" aria-label="{{ 'products.product.gallery' | t }}">
        {%- for media in product.media %}
          <li class="pdp__media" id="media-{{ section.id }}-{{ media.id }}" data-media-id="{{ media.id }}">
            {{
              media.preview_image
              | image_url: width: 1400
              | image_tag:
                class: 'pdp__img',
                loading: 'lazy',
                widths: '480,720,960,1280',
                sizes: '(min-width: 900px) 34vw, 46vw',
                alt: media.alt
            }}
          </li>
        {%- endfor %}
      </ul>
    {%- endif %}

    <div class="pdp__more">
      {%- for block in section.blocks %}
        {%- if zone_below contains block.type %}
          {%- render 'pdp-block', block: block, section_id: section.id, form_id: form_id, has_picker: has_picker, current: current, product: product %}
        {%- endif %}
      {%- endfor %}
    </div>
  </div>

  {%- comment -%} Phones: a bar with the price and the button appears once the main button scrolls away. {%- endcomment -%}
  <div class="pdp__bar" data-sticky-bar hidden>
    <div class="pdp__bar-text">
      <strong>{{ product.title }}</strong>
      <span data-bar-price>{{ current.price | money }}</span>
    </div>
    <button type="submit" form="{{ form_id }}" class="pdp__atc pdp__atc--bar" data-bar-atc tabindex="-1"{% unless current.available %} disabled{% endunless %}>
      <span data-bar-label>
        {%- if current.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif -%}
      </span>
    </button>
  </div>

  <script type="application/json" data-product-json>
    {
      "variants": [
        {%- for variant in product.variants %}
          {
            "id": {{ variant.id | json }},
            "options": {{ variant.options | json }},
            "available": {{ variant.available | json }},
            "cents": {{ variant.price | json }},
            "compareCents": {{ variant.compare_at_price | default: 0 | json }},
            "price": {{ variant.price | money | json }},
            "compare": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}""{% endif %},
            "unit": {% if variant.unit_price_measurement %}{{ variant.unit_price | unit_price_with_measurement: variant.unit_price_measurement | json }}{% else %}""{% endif %},
            "media": {{ variant.featured_media.id | default: 0 | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor %}
      ],
      "moneyFormat": {{ shop.money_format | json }},
      "labels": {
        "add": {{ 'products.product.add_to_cart' | t | json }},
        "soldOut": {{ 'products.product.sold_out' | t | json }},
        "unavailable": {{ 'products.product.unavailable' | t | json }},
        "added": {{ 'cart.added' | t | json }},
        "viewCart": {{ 'cart.view_cart' | t | json }},
        "error": {{ 'cart.error' | t | json }},
        "cartUrl": {{ routes.cart_url | json }}
      }
    }
  </script>

  {%- comment -%} Structured data: Product (offers, availability, images) and the breadcrumb trail. {%- endcomment -%}
  <script type="application/ld+json">{{ product | structured_data }}</script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ 'general.home' | t | json }}, "item": {{ shop.url | append: routes.root_url | json }} }
        {%- if crumb_collection != blank %},
        { "@type": "ListItem", "position": 2, "name": {{ crumb_collection.title | json }}, "item": {{ shop.url | append: crumb_collection.url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
        {%- else %},
        { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ shop.url | append: product.url | json }} }
        {%- endif %}
      ]
    }
  </script>
</section>

<script src="{{ 'product.js' | asset_url }}" type="module" defer></script>

{% schema %}
{
  "name": "Product",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "scene_image", "label": "Scene background photo", "info": "A wide, dark-ish lifestyle photo (plantation, hillside). It is darkened and moves slowly behind the bag. Leave empty for a warm gradient." },
    { "type": "checkbox", "id": "show_leaves", "label": "Show the branches in front of the scene", "default": true },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Photo fit",
      "options": [
        { "value": "cover", "label": "Fill the frame (lifestyle photos)" },
        { "value": "contain", "label": "Show the whole photo (product on a plain background)" }
      ],
      "default": "cover"
    }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_eyebrow", "label": "Show product type above the title", "default": true }
      ]
    },
    { "type": "price", "name": "Price", "limit": 1 },
    {
      "type": "tasting_notes",
      "name": "Tasting notes",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Tasting notes" },
        { "type": "text", "id": "notes", "label": "Notes (comma separated)", "default": "Jasmine, bergamot, raspberry", "info": "Connect this field to a product metafield (dynamic source) to set different notes per product." }
      ]
    },
    {
      "type": "roast_scale",
      "name": "Roast scale",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "level", "label": "Roast level", "min": 1, "max": 5, "step": 1, "default": 3, "info": "1 is light, 5 is dark." }
      ]
    },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    { "type": "selling_plan", "name": "Subscription options", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_quantity", "label": "Show quantity selector", "default": true },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show accelerated checkout buttons", "default": true, "info": "Shop Pay, Apple Pay and Google Pay, when enabled in your payment settings." }
      ]
    },
    {
      "type": "trust_row",
      "name": "Trust row",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text_1", "label": "Point 1", "default": "Roasted to order" },
        { "type": "text", "id": "text_2", "label": "Point 2", "default": "Ships in 48 hours" },
        { "type": "text", "id": "text_3", "label": "Point 3", "default": "Free shipping over $50" }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "accordion",
      "name": "Collapsible row",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Brew guide" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Add your brewing recommendation here.</p>" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ]
}
{% endschema %}
