<header class="site-header" data-section-id="{{ section.id }}" data-section-type="header">
  <a class="site-header__brand" href="{{ routes.root_url }}">{{ shop.name }}</a>

  {%- if section.settings.menu != blank %}
    <nav aria-label="{{ 'general.main_navigation' | t }}">
      <ul>
        {%- for link in section.settings.menu.links %}
          <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  {%- endif %}

  <a class="site-header__cart" href="{{ routes.cart_url }}" data-cart-link data-label="{{ 'cart.header_label' | t: count: '__COUNT__' }}" aria-label="{{ 'cart.header_label' | t: count: cart.item_count }}">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 8h14l-1.2 12H6.2L5 8Z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/></svg>
    <span class="site-header__cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
  </a>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}