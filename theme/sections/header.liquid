{%- if section.settings.announcement != blank %}
  <div class="announce" role="region" aria-label="{{ 'general.announcement' | t }}">
    {%- if section.settings.announcement_link != blank %}
      <a href="{{ section.settings.announcement_link }}">{{ section.settings.announcement }}</a>
    {%- else %}
      <p>{{ section.settings.announcement }}</p>
    {%- endif %}
  </div>
{%- endif %}

<header class="site-header" data-section-id="{{ section.id }}" data-section-type="header">
  <a class="site-header__brand" href="{{ routes.root_url }}">{{ shop.name }}</a>

  {%- if section.settings.menu != blank %}
    <nav class="site-header__nav" id="site-nav-{{ section.id }}" aria-label="{{ 'general.main_navigation' | t }}">
      <ul>
        {%- for link in section.settings.menu.links %}
          <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  {%- endif %}

  <div class="site-header__tools">
    {%- if section.settings.show_search %}
      <a class="site-header__btn" href="{{ routes.search_url }}" aria-label="{{ 'general.search' | t }}">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
      </a>
    {%- endif %}
    <a class="site-header__btn site-header__cart" href="{{ routes.cart_url }}" data-cart-link data-label="{{ 'cart.header_label' | t: count: '__COUNT__' }}" aria-label="{{ 'cart.header_label' | t: count: cart.item_count }}">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 8h14l-1.2 12H6.2L5 8Z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/></svg>
      <span class="site-header__cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
    </a>
    {%- if section.settings.menu != blank %}
      <button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="site-nav-{{ section.id }}" aria-label="{{ 'general.menu' | t }}" data-menu-toggle data-label-open="{{ 'general.menu' | t }}" data-label-close="{{ 'general.close_menu' | t }}">
        <span></span><span></span>
      </button>
    {%- endif %}
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "checkbox", "id": "show_search", "label": "Show the search button", "default": true },
    { "type": "header", "content": "Announcement bar" },
    { "type": "text", "id": "announcement", "label": "Text", "info": "Leave empty to hide the bar.", "default": "Roasted to order · Ships in 48 hours" },
    { "type": "url", "id": "announcement_link", "label": "Link (optional)" }
  ]
}
{% endschema %}
