<section
  class="roast-sim"
  id="roast-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="roast-simulator"
>
  <div class="roast-sim__container">
    <h2 class="roast-sim__title">{{ section.settings.heading }}</h2>

    <div class="roast-sim__layout">
      <div class="roast-sim__canvas-col">
        <canvas class="roast-sim__canvas" aria-hidden="true"></canvas>
        {%- if section.settings.image_bean_still != blank %}
          {{
            section.settings.image_bean_still
            | image_url: width: 800
            | image_tag:
              class: 'roast-sim__fallback',
              loading: 'lazy',
              widths: '400,800',
              sizes: '(min-width:900px) 40vw, 90vw'
          }}
        {%- else -%}
          <div class="roast-sim__fallback roast-sim__fallback--placeholder"></div>
        {%- endif %}

        <div class="roast-sim__slider-wrap">
          <label for="roast-range-{{ section.id }}" class="roast-sim__slider-label">
            Temperature
            <output class="roast-sim__temp-value" id="roast-temp-{{ section.id }}">190</output>°C
          </label>
          <input
            type="range"
            id="roast-range-{{ section.id }}"
            class="roast-sim__range"
            min="0"
            max="1"
            step="0.01"
            value="0.5"
          >
        </div>
      </div>

      <div class="roast-sim__info-col">
        <div class="roast-sim__stages" role="group" aria-label="Roast stages">
          {%- for block in section.blocks %}
            <button
              class="roast-sim__stage-btn{% if forloop.index0 == 2 %} roast-sim__stage-btn--active{% endif %}"
              data-stage-index="{{ forloop.index0 }}"
              data-stage-color="{{ block.settings.color }}"
              data-stage-rough="{{ block.settings.roughness }}"
              data-stage-coat="{{ block.settings.clearcoat }}"
              data-stage-wrinkle="{{ block.settings.wrinkle }}"
              data-stage-temp="{{ block.settings.temp }}"
              aria-pressed="{% if forloop.index0 == 2 %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              <span class="roast-sim__stage-dot" style="background:{{ block.settings.color }}"></span>
              {{ block.settings.name }}
            </button>
          {%- endfor %}
        </div>

        <div class="roast-sim__diagnosis">
          <div class="roast-sim__notes">
            <strong>Tasting notes:</strong>
            <span class="roast-sim__notes-text">Balanced acidity, caramel, chocolate</span>
          </div>
          <div class="roast-sim__bars">
            <div class="roast-sim__bar-row">
              <span class="roast-sim__bar-label">Acidity</span>
              <div class="roast-sim__bar"><div class="roast-sim__bar-fill" data-sense="acidity" role="progressbar" aria-label="Acidity" aria-valuemin="0" aria-valuemax="100" aria-valuenow="65" style="width:65%"></div></div>
            </div>
            <div class="roast-sim__bar-row">
              <span class="roast-sim__bar-label">Body</span>
              <div class="roast-sim__bar"><div class="roast-sim__bar-fill" data-sense="body" role="progressbar" aria-label="Body" aria-valuemin="0" aria-valuemax="100" aria-valuenow="55" style="width:55%"></div></div>
            </div>
            <div class="roast-sim__bar-row">
              <span class="roast-sim__bar-label">Sweetness</span>
              <div class="roast-sim__bar"><div class="roast-sim__bar-fill" data-sense="sweetness" role="progressbar" aria-label="Sweetness" aria-valuemin="0" aria-valuemax="100" aria-valuenow="60" style="width:60%"></div></div>
            </div>
          </div>
        </div>

        <table class="roast-sim__table">
          <thead>
            <tr>
              <th>Stage</th>
              <th>Temp °C</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks %}
              <tr data-stage-row="{{ forloop.index0 }}">
                <td>
                  <span class="roast-sim__stage-dot-sm" style="background:{{ block.settings.color }}"></span>
                  {{ block.settings.name }}
                </td>
                <td>{{ block.settings.temp }}°C</td>
                <td>{{ block.settings.notes }}</td>
              </tr>
            {%- endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Roast Simulator",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The art of roasting" },
    { "type": "image_picker", "id": "image_bean_still", "label": "Bean fallback image" }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Roast stage",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Drying" },
        { "type": "color", "id": "color", "label": "Bean color", "default": "#6F7A4C" },
        { "type": "range", "id": "roughness", "label": "Roughness", "min": 0, "max": 100, "step": 1, "default": 74 },
        { "type": "range", "id": "clearcoat", "label": "Clearcoat", "min": 0, "max": 100, "step": 1, "default": 0 },
        { "type": "range", "id": "wrinkle", "label": "Wrinkle", "min": 0, "max": 100, "step": 1, "default": 5 },
        { "type": "range", "id": "temp", "label": "Temperature °C", "min": 150, "max": 250, "step": 1, "default": 165 },
        { "type": "text", "id": "notes", "label": "Tasting notes", "default": "Grassy, vegetal" }
      ]
    }
  ],
  "presets": [{
    "name": "Roast Simulator",
    "blocks": [
      { "type": "stage", "settings": { "name": "Drying", "color": "#6F7A4C", "roughness": 74, "clearcoat": 0, "wrinkle": 5, "temp": 165, "notes": "Grassy, hay, vegetal" }},
      { "type": "stage", "settings": { "name": "Maillard", "color": "#8A6338", "roughness": 64, "clearcoat": 4, "wrinkle": 9, "temp": 180, "notes": "Bread, toasted grain" }},
      { "type": "stage", "settings": { "name": "First crack", "color": "#43271A", "roughness": 46, "clearcoat": 20, "wrinkle": 14, "temp": 200, "notes": "Caramel, chocolate, fruit" }},
      { "type": "stage", "settings": { "name": "Second crack", "color": "#2A160D", "roughness": 38, "clearcoat": 28, "wrinkle": 17, "temp": 225, "notes": "Dark chocolate, smoky" }},
      { "type": "stage", "settings": { "name": "Dark", "color": "#150C08", "roughness": 28, "clearcoat": 50, "wrinkle": 20, "temp": 240, "notes": "Charcoal, bitter, bold" }}
    ]
  }]
}
{% endschema %}