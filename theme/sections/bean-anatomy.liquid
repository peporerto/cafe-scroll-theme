<section
  class="anat"
  id="bean-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="bean-anatomy"
  data-spin-url="{{ 'bean-spin-000.webp' | asset_url }}"
  data-spin-count="72"
>
  <div class="anat__stage">
    <header class="anat__head">
      <p class="anat__eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="anat__title">{{ section.settings.heading }}</h2>
    </header>

    <div class="anat__bean bean-box">
      <div class="bean-box__shadow"></div>
      <img class="anat__frame0" src="{{ 'bean-spin-000.webp' | asset_url }}" alt="{{ section.settings.bean_alt }}" width="560" height="560" loading="lazy">
      <canvas class="anat__canvas" aria-hidden="true"></canvas>
      <img class="anat__cut" src="{{ 'bean-cut.webp' | asset_url }}" alt="{{ section.settings.cut_alt }}" width="616" height="561" loading="lazy">
    </div>

    <svg class="anat__lines" aria-hidden="true"></svg>

    <ol class="anat__cards">
      {%- for block in section.blocks %}
        <li class="anat__card" data-slot="{{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
          <h3 class="anat__card-title">{{ block.settings.title }}</h3>
          <p class="anat__card-text">{{ block.settings.text }}</p>
        </li>
      {%- endfor %}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Bean Anatomy",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "02 / Our bean" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Anatomy of a bean" },
    { "type": "text", "id": "bean_alt", "label": "Bean image description", "default": "Roasted coffee bean" },
    { "type": "text", "id": "cut_alt", "label": "Cross-section image description", "default": "Roasted coffee bean cut in half, showing its inner cell structure" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Anatomy callout",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Center crease" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "The seam that splits during roasting, releasing CO₂ and volatile aromatics." }
      ]
    }
  ],
  "presets": [{
    "name": "Bean Anatomy",
    "blocks": [
      { "type": "card", "settings": { "title": "Silver skin", "text": "The thin chaff layer that detaches during roasting." }},
      { "type": "card", "settings": { "title": "Center crease", "text": "The seam that splits during first crack, releasing CO₂ and volatiles." }},
      { "type": "card", "settings": { "title": "Cell structure", "text": "Thousands of cells expand with heat, trapping oils and flavor compounds." }},
      { "type": "card", "settings": { "title": "Surface oils", "text": "Lipids migrate outward in dark roasts, creating the characteristic sheen." }}
    ]
  }]
}
{% endschema %}
