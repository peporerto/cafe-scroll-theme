<section
  class="hero"
  id="hero-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="hero"
  data-focus-x="{{ section.settings.focus_x | default: 34 }}"
  data-focus-y="{{ section.settings.focus_y | default: 58 }}"
  style="--focus-x: {{ section.settings.focus_x | default: 34 }}%; --focus-y: {{ section.settings.focus_y | default: 58 }}%;"
>
  <div class="hero__pin-wrap">
    {%- comment -%} Layer 1: the closed bag in the plantation (zooms toward the bag, then dissolves into the open-bag photo) {%- endcomment -%}
    <div class="hero__zoom">
      <div class="hero__layer hero__layer--far">
      {%- if section.settings.image_far != blank %}
        {{
          section.settings.image_far
          | image_url: width: 2400
          | image_tag:
            class: 'hero__img hero__img--far',
            loading: 'eager',
            fetchpriority: 'high',
            widths: '600,900,1200,1800,2400',
            sizes: '100vw'
        }}
      {%- else -%}
        <div class="hero__img hero__img--far hero__img--placeholder hero__scenery" aria-hidden="true">
          <div class="hero__sun"></div>
          <svg class="hero__ridge" data-depth="0.25" viewBox="0 0 1440 600" preserveAspectRatio="none"><path d="M0 330 L120 280 L240 320 L380 240 L520 300 L660 220 L800 290 L940 230 L1080 300 L1220 250 L1340 300 L1440 270 L1440 600 L0 600Z" fill="#2c3a33"/></svg>
          <svg class="hero__ridge" data-depth="0.5" viewBox="0 0 1440 600" preserveAspectRatio="none"><path d="M0 400 L160 340 L300 390 L460 320 L620 380 L780 330 L940 390 L1100 340 L1260 395 L1440 350 L1440 600 L0 600Z" fill="#1f2a25"/></svg>
          <svg class="hero__ridge" data-depth="0.85" viewBox="0 0 1440 600" preserveAspectRatio="none"><path d="M0 480 L200 430 L380 470 L560 420 L760 470 L960 425 L1160 475 L1320 440 L1440 470 L1440 600 L0 600Z" fill="#141a17"/></svg>
          <div class="hero__mist"></div>
        </div>
      {%- endif %}
      </div>
    </div>

    {%- comment -%} The bag opens: its own photo (close-up of the open bag), cross-faded in while the closed-bag photo zooms into it. The bean jumps out of this one. {%- endcomment -%}
    <div class="hero__layer hero__layer--open">
    {%- if section.settings.image_open != blank %}
      {{
        section.settings.image_open
        | image_url: width: 2400
        | image_tag:
          class: 'hero__img hero__img--open',
          loading: 'eager',
          widths: '600,900,1200,1800,2400',
          sizes: '100vw'
      }}
    {%- endif %}
    </div>

    <div class="hero__wash" aria-hidden="true"></div>

    {%- comment -%} The one bean of the whole scene: it jumps out of the bag, then the same element spins (frame sequence on the canvas) and splits open (cross-section). Full-motion only. {%- endcomment -%}
    <div class="hero__cutout bean-box" aria-hidden="true" data-spin-url="{{ 'bean-spin-000.webp' | asset_url }}" data-spin-count="72">
      <div class="bean-box__shadow"></div>
      <img class="hero__cutout-img" src="{{ 'bean-spin-000.webp' | asset_url }}" alt="" width="560" height="560" loading="lazy">
      <canvas class="anat__canvas" aria-hidden="true"></canvas>
      <img class="anat__cut" src="{{ 'bean-cut.webp' | asset_url }}" alt="" width="616" height="561" loading="lazy">
    </div>

    {%- comment -%} Text overlay {%- endcomment -%}
    <div class="hero__content">
      <h1 class="hero__heading">
        <span class="hero__heading-line">{{ section.settings.heading_line_1 }}</span>
        <span class="hero__heading-line hero__heading-line--accent">{{ section.settings.heading_line_2 }}</span>
      </h1>
      {%- if section.settings.subtext != blank %}
        <p class="hero__subtext">{{ section.settings.subtext }}</p>
      {%- endif %}
    </div>

  </div>

  {%- comment -%} CSS depth vignette {%- endcomment -%}
  <div class="hero__vignette" aria-hidden="true"></div>

  {%- comment -%} Anatomy of the bean: part of the same scene (heading, lines and callouts over the bean). Without motion it is a normal block under the hero. {%- endcomment -%}
  <div class="hero__anat anat">
    <header class="anat__head">
      <p class="anat__eyebrow">{{ section.settings.anat_eyebrow }}</p>
      <h2 class="anat__title">{{ section.settings.anat_heading }}</h2>
    </header>

    <img class="anat__static-bean" src="{{ 'bean-spin-000.webp' | asset_url }}" alt="{{ section.settings.bean_alt }}" width="560" height="560" loading="lazy">

    <svg class="anat__lines" aria-hidden="true"></svg>

    <ol class="anat__cards">
      {%- for block in section.blocks %}
        <li class="anat__card" data-slot="{{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
          <h3 class="anat__card-title">{{ block.settings.title }}</h3>
          <p class="anat__card-text">{{ block.settings.text }}</p>
        </li>
      {%- endfor %}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "heading_line_1", "label": "Heading line 1", "default": "From the mountain" },
    { "type": "text", "id": "heading_line_2", "label": "Heading line 2", "default": "to your cup" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Single-origin specialty coffee, roasted to order." },
    { "type": "image_picker", "id": "image_far", "label": "Image 1: closed bag in the plantation" },
    { "type": "image_picker", "id": "image_open", "label": "Image 2: close-up of the open bag with beans (the bean jumps out of it)" },
    { "type": "range", "id": "focus_x", "label": "Focus X %", "min": 0, "max": 100, "step": 1, "default": 34 },
    { "type": "range", "id": "focus_y", "label": "Focus Y %", "min": 0, "max": 100, "step": 1, "default": 58 },
    { "type": "header", "content": "Bean anatomy (same scene, right after the bean jumps out)" },
    { "type": "text", "id": "anat_eyebrow", "label": "Small label", "default": "Our bean" },
    { "type": "text", "id": "anat_heading", "label": "Heading", "default": "Anatomy of a bean" },
    { "type": "text", "id": "bean_alt", "label": "Bean image description", "default": "Roasted coffee bean" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Anatomy callout",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Center crease" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "The seam that splits during roasting, releasing CO₂ and volatile aromatics." }
      ]
    }
  ],
  "presets": [{
    "name": "Hero",
    "blocks": [
      { "type": "card", "settings": { "title": "Silver skin", "text": "The thin chaff layer that detaches during roasting." }},
      { "type": "card", "settings": { "title": "Center crease", "text": "The seam that splits during first crack, releasing CO₂ and volatiles." }},
      { "type": "card", "settings": { "title": "Cell structure", "text": "Thousands of cells expand with heat, trapping oils and flavor compounds." }},
      { "type": "card", "settings": { "title": "Surface oils", "text": "Lipids migrate outward in dark roasts, creating the characteristic sheen." }}
    ]
  }]
}
{% endschema %}
