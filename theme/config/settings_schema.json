      { "type": "color", "id": "color_accent", "label": "Accent", "default": "#E8603F" },
      { "type": "color", "id": "color_muted", "label": "Muted text", "default": "#E6D5BD" }
    ]
  },
  {
    "name": "Scene",
    "settings": [
      { "type": "image_picker", "id": "scene_image", "label": "Default scene photo", "info": "A wide, dark-ish lifestyle photo used behind page titles (collections, cart, blog, search, 404...). Each page can override it in the theme editor. Empty = warm gradient." }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "url", "id": "social_instagram", "label": "Instagram" },
      { "type": "url", "id": "social_tiktok", "label": "TikTok" },
      { "type": "url", "id": "social_youtube", "label": "YouTube" },
      { "type": "url", "id": "social_facebook", "label": "Facebook" },
      { "type": "url", "id": "social_pinterest", "label": "Pinterest" }
    ]
  },
  {
    "name": "Motion",
    "settings": [
      {
        "type": "select",
        "id": "motion_level",
        "label": "Animation intensity",
        "info": "Visitors with reduced motion always get the static version.",
        "options": [
          { "value": "full", "label": "Full" },
          { "value": "reduced", "label": "Reduced" },
          { "value": "off", "label": "Off" }
        ],
        "default": "full"
      }
    ]
  },
  {
    "name": "Depth effects",
    "settings": [
      {
        "type": "select",
        "id": "depth_effects",
        "label": "Depth effects",
        "info": "Controls particles, shadows, and pointer parallax. Light disables particles and dynamic shadows.",
        "options": [
          { "value": "full", "label": "Full" },
          { "value": "light", "label": "Light" },
          { "value": "off", "label": "Off" }
        ],
        "default": "full"
      }
